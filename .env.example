# Database (use DATABASE_URL for Lambda/RDS, or individual vars for local)
DATABASE_URL=postgresql://user:password@your-rds-proxy-endpoint:5432/teethforlife
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=TeethForLife

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_EMAIL=admin@teethforlife.pk
ADMIN_PASSWORD_HASH=bcrypt-hash-here

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Frontend
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net

# AWS (Lambda deployment)
LAMBDA_SECURITY_GROUP_ID=sg-xxxxxxxxx
SUBNET_ID_1=subnet-xxxxxxxxx
SUBNET_ID_2=subnet-xxxxxxxxx
