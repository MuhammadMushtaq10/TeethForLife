# ─── Database (local dev) ───────────────────────────────
# Used when DATABASE_URL is unset. The app falls back to these values.
# Host of your local Postgres server.
DB_HOST=127.0.0.1
# Postgres port (default 5432).
DB_PORT=5432
# Postgres username.
DB_USERNAME=postgres
# Postgres password.
DB_PASSWORD=
# Database name.
DB_NAME=TeethForLife1

# ─── Database (Supabase cloud) ──────────────────────────
# Optional. When set, the app switches to connection-string + SSL mode and
# ignores the DB_* vars above. Use the Supabase transaction pooler (port 6543)
# for the deployed app. URL-encode any '@' in the password as %40.
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# ─── Auth ───────────────────────────────────────────────
# Secret used to sign admin JWTs (use a long random string).
JWT_SECRET=
# Email for the single admin login.
ADMIN_EMAIL=
# bcrypt hash of the admin password (NOT the plain password).
ADMIN_PASSWORD_HASH=

# ─── Email (SMTP) ───────────────────────────────────────
# SMTP server host (e.g. smtp.gmail.com).
SMTP_HOST=
# SMTP port (default 587).
SMTP_PORT=587
# SMTP username; also used as the "from" address.
SMTP_USER=
# SMTP password. For Gmail, use a 16-char App Password, not your account password.
SMTP_PASS=
# Where contact-form messages are delivered (defaults to SMTP_USER if unset).
CONTACT_TO=

# ─── Misc ───────────────────────────────────────────────
# Allowed CORS origin (your frontend URL).
FRONTEND_URL=http://localhost:5173
# Local server port.
PORT=3000
# Set to "production" to disable TypeORM query logging.
NODE_ENV=development
